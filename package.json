{
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "preinstall": "pnpm exec only-allow pnpm",
    "sandcastle": "pnpm exec tsx .sandcastle/main.mts",
    "test": "node scripts/validate-roadmap.mjs && node scripts/validate-stripe-app-package.test.mjs && node scripts/validate-marketplace-listing.mjs",
    "test:stripe-app": "node scripts/validate-stripe-app-package.test.mjs",
    "test:marketplace-listing": "node scripts/validate-marketplace-listing.mjs",
    "typecheck": "pnpm --dir web run typecheck"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.5.7"
  },
  "devDependencies": {
    "only-allow": "^1.2.2",
    "tsx": "^4.21.0"
  },
  "license": "GPL-3.0-or-later"
}
